{
  "name": "matsu-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "npm run typecheck && npm run check:fleet && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "seed:agents": "AGENT_CALL_TIMEOUT_MS=180000 tsx scripts/seed-run.ts",
    "check:fleet": "tsx scripts/check-fleet-honesty.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@clerk/backend": "^3.14.0",
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ai": "^7.0.42",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.9.2",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
